# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dgap?schema=public"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Used by `npm run db:seed` to create the first admin. Remove after first run.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://dgapbrownie.in
# Digits only with country code, e.g. 91XXXXXXXXXX. Leave empty to hide WhatsApp buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Payments (optional). Razorpay is enabled only when BOTH are set. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
