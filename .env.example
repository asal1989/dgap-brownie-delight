# ---------- Database (PostgreSQL) ----------
# Local dev uses the project-local cluster started by `npm run db:start` (port 5433).
DATABASE_URL="postgresql://dgap@127.0.0.1:5433/dgap_dev"
# Used only by tests (`npm test`, `npm run test:e2e`). Must be a different database.
TEST_DATABASE_URL="postgresql://dgap@127.0.0.1:5433/dgap_test"

# ---------- Site ----------
# Public origin, no trailing slash. Leave empty until the production domain exists.
SITE_URL="http://localhost:3000"

# ---------- Admin provisioning (never commit real values) ----------
# `npm run admin:create` reads these. Use a unique password of 12+ characters.
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_PASSWORD=""

# ---------- Payments ----------
# razorpay | dev | off.  Default: razorpay when keys are set, otherwise dev (non-production only).
# In production without Razorpay keys, online payment is switched off. dev mode is refused in production.
PAYMENT_MODE=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---------- WhatsApp (digits with country code). Can also be set in Admin > Settings. ----------
WHATSAPP_NUMBER=""

# ---------- Email (Resend). Without a key, notifications are recorded but not sent. ----------
RESEND_API_KEY=""
EMAIL_FROM="DGAP Brownie Delight <orders@your-domain.example>"
# Set to 1 to print notification emails to the server log in development instead of skipping them.
NOTIFICATIONS_DEV_LOG=""

# ---------- Image storage (Vercel Blob). Without a token, uploads go to public/uploads in development only. ----------
BLOB_READ_WRITE_TOKEN=""

# ---------- Cron / background jobs ----------
# Bearer token required by /api/cron/* endpoints (Vercel Cron sends it automatically).
CRON_SECRET=""

# ---------- Guest order access ----------
# Random 32+ character string used to sign the cookie that lets guests view the orders they placed.
# Required in production: generate with `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
ORDER_ACCESS_SECRET=""
